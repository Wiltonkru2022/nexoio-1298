{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nexoio-admin",
  "compatibility_date": "2026-08-28",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "env": {
    "staging": {
      "name": "nexoio-admin-staging",
      "workers_dev": false,
      "routes": [{ "pattern": "admin-staging.nexoio.com.br", "custom_domain": true }]
    },
    "production": {
      "name": "nexoio-admin",
      "workers_dev": false,
      "routes": [{ "pattern": "admin.nexoio.com.br", "custom_domain": true }]
    }
  }
}
