{
  "name": "nexoio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "workers/*", "packages/*"],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:api": "npm run dev -w @nexoio/api",
    "dev:merchant": "npm run dev -w @nexoio/merchant",
    "print-agent": "node tools/restaurant-print-agent.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "release:preflight": "tsx scripts/release-preflight.ts",
    "db:migrate": "npm run release:preflight && tsx database/scripts/migrate.ts",
    "db:seed": "tsx database/seeds/seed.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "better-auth": "^1.7.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.67",
    "@cloudflare/workers-types": "^5.20260828.1",
    "@eslint/js": "^9.34.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "postgres": "^3.4.7",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.127.0"
  },
  "engines": { "node": ">=20.19" }
}
