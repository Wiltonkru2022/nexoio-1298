{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nexoio-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "vars": { "AUTH_URL": "http://localhost:8787", "APP_URL": "http://localhost:5173", "ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:5174,http://localhost:5175" },
  "r2_buckets": [{ "binding": "R2_BUCKET", "bucket_name": "nexoio-development" }],
  "env": {
    "staging": {
      "name": "nexoio-api-staging",
      "workers_dev": false,
      "routes": [{ "pattern": "api-staging.nexoio.com.br", "custom_domain": true }],
      "vars": { "AUTH_URL": "https://api-staging.nexoio.com.br", "APP_URL": "https://app-staging.nexoio.com.br", "ALLOWED_ORIGINS": "https://app-staging.nexoio.com.br,https://admin-staging.nexoio.com.br" },
      "r2_buckets": [{ "binding": "R2_BUCKET", "bucket_name": "nexoio-staging" }]
    },
    "production": {
      "name": "nexoio-api",
      "workers_dev": false,
      "routes": [{ "pattern": "api.nexoio.com.br", "custom_domain": true }],
      "vars": { "AUTH_URL": "https://api.nexoio.com.br", "APP_URL": "https://app.nexoio.com.br", "ALLOWED_ORIGINS": "https://app.nexoio.com.br,https://admin.nexoio.com.br" },
      "r2_buckets": [{ "binding": "R2_BUCKET", "bucket_name": "nexoio-prod" }]
    }
  }
}
